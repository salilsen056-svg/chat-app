DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/hello_chat
PORT=3000

# Optional TURN relay for calls across restrictive networks. Never commit real credentials.
# TURN_URL=turn:your-relay.example.com:3478,turns:your-relay.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Alternative: free Metered/Open Relay account (server-side API key only).
# METERED_DOMAIN=your-app.metered.live
# METERED_API_KEY=
